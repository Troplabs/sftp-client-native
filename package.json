{
  "name": "@troplabs/sftp-client-native",
  "version": "0.1.0",
  "description": "Asynchronous Node.js SFTP client backed by russh",
  "keywords": ["napi", "native-addon", "russh", "sftp", "ssh"],
  "homepage": "https://github.com/troplabs/sftp-client-native#readme",
  "bugs": { "url": "https://github.com/troplabs/sftp-client-native/issues" },
  "repository": { "type": "git", "url": "https://github.com/troplabs/sftp-client-native.git" },
  "license": "Apache-2.0",
  "type": "module",
  "exports": { ".": { "types": "./index.d.ts", "import": "./index.mjs" } },
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "files": ["index.mjs", "index.d.ts", "*.node", "README.md", "LICENSE"],
  "scripts": {
    "build": "napi build --platform --esm --js index.mjs --release",
    "build:debug": "napi build --platform --esm --js index.mjs",
    "check": "cargo check",
    "fmt:check": "cargo fmt --all -- --check",
    "prepack": "pnpm run build",
    "smoke:public-sftp": "node scripts/smoke-public-sftp.mjs"
  },
  "devDependencies": { "@napi-rs/cli": "^3.10.5", "dprint": "^0.57.4" },
  "packageManager": "pnpm@12.7.0",
  "engines": { "node": ">=24.21" },
  "publishConfig": { "access": "public" },
  "napi": { "binaryName": "sftp-client-native", "napiVersion": 8, "packageName": "@troplabs/sftp-client-native" }
}
