{
  "name": "@troplabs/sftp-client-native",
  "version": "0.1.2",
  "description": "Asynchronous Node.js SFTP client backed by russh",
  "keywords": ["napi", "native-addon", "russh", "sftp", "ssh"],
  "homepage": "https://github.com/troplabs/sftp-client-native#readme",
  "bugs": { "url": "https://github.com/troplabs/sftp-client-native/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/troplabs/sftp-client-native.git" },
  "license": "Apache-2.0",
  "type": "module",
  "exports": { ".": { "types": "./index.d.ts", "import": "./index.mjs" } },
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "files": ["index.mjs", "index.d.ts", "README.md", "LICENSE"],
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --esm --js index.mjs --release",
    "build:debug": "napi build --platform --esm --js index.mjs",
    "check": "cargo check",
    "fmt:check": "cargo fmt --all -- --check",
    "prepublishOnly": "napi prepublish -t npm",
    "smoke:public-sftp": "node scripts/smoke-public-sftp.mjs",
    "version": "napi version"
  },
  "devDependencies": { "@napi-rs/cli": "^3.10.6", "dprint": "^0.58.0" },
  "packageManager": "pnpm@12.8.1",
  "engines": { "node": ">=24.21" },
  "publishConfig": { "registry": "https://registry.npmjs.org/", "access": "public", "provenance": true },
  "napi": {
    "binaryName": "sftp-client-native",
    "packageName": "@troplabs/sftp-client-native",
    "napiVersion": 8,
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  }
}
